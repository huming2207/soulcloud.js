# Shared PostgreSQL database
# POSTGRES_PASSWORD overrides the compose default (soulcloud); compose
# interpolates it into DATABASE_URL for the api/broker services.
POSTGRES_PASSWORD=soulcloud
DATABASE_URL=postgres://soulcloud:soulcloud@127.0.0.1:5432/soulcloud

# Test suite database (isolated from the dev broker's global queue polling;
# created automatically by scripts/prepare-test-db.ts)
TEST_DATABASE_URL=postgres://soulcloud:soulcloud@127.0.0.1:5432/soulcloud_test

# ===========================================================================
# REQUIRED: JWT secret shared by BOTH processes.
#   - no default; both api and broker FAIL TO START without it
#   - the broker signs OTA download JWTs with it, the api verifies them
#   - >= 32 characters, use `openssl rand -base64 48` or similar
#   - keep it out of version control in production
# ===========================================================================
JWT_SECRET=change-me-to-a-strong-random-secret-0123456789

# API server
API_BIND_ADDRESS=0.0.0.0:8080
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# MQTT broker (MQTT over WebSocket only; TLS terminates at the reverse proxy)
MQTT_BROKER_PORT=1883
MQTT_BROKER_PATH=/mqtt

# Retained flag for command messages. Use false until the contract is finalized.
# Refused (startup error) when NODE_ENV=production: retained state is never
# cleared and can replay stale commands to devices after a reboot.
MQTT_COMMAND_RETAIN=false

# Max concurrent Argon2id device-auth verifications (CPU guard; a reconnect
# burst beyond this queues, beyond 4x this is refused).
BROKER_AUTH_CONCURRENCY=8

# Command queue
COMMAND_POLL_INTERVAL_MS=500
COMMAND_LEASE_SECONDS=60
# Delivery-deadline expiry sweep cadence (deadlines need seconds of
# precision; throttles the maintenance UPDATEs below the drain poll).
COMMAND_EXPIRE_INTERVAL_MS=15000

# OTA
# Delivery window for a pending target before it expires (device offline too
# long -> never delivered)
OTA_TARGET_TTL_SECONDS=900
# Broker: ota poller cadence + lease
OTA_POLL_INTERVAL_MS=500
OTA_LEASE_SECONDS=60
# OTA expiry maintenance cadence (target expiry + stall sweeps).
OTA_EXPIRE_INTERVAL_MS=15000
# Broker: download JWT lifetime (minted at publish time)
OTA_TOKEN_TTL_SECONDS=900
# Broker: a delivered/delivering/downloaded target that never completes its
# download within this window is failed with code -7
OTA_STALL_TIMEOUT_MINUTES=30

# API request-body ceilings (WEB-09)
# Global Bun ceiling (must exceed the largest firmware multipart ~64 MiB)
MAX_BODY_BYTES=83886080
# Route-level cap for non-multipart (JSON) bodies, applied before parsing
MAX_JSON_BODY_BYTES=1048576

# Public login/registration Argon2 admission control. Each Argon2 operation
# uses substantial memory; excess concurrent requests receive HTTP 429 and
# are not queued. Size this for the API host's RAM and CPU.
AUTH_ARGON2_CONCURRENCY=4
# Maximum distinct usernames retained by the in-process login failure cache.
AUTH_LOGIN_FAILURE_CAPACITY=10000

# Logging
LOG_LEVEL=info

# Uplink ingestion protection (DDoS / misbehaving devices)
UPLINK_MAX_PACKET_BYTES=65536
UPLINK_RATE_PER_SECOND=20
UPLINK_RATE_BURST=100
# Global handler concurrency and hard executing+queued work capacity.
# Messages above the capacity are dropped with a broker warning. Keep capacity
# >= concurrency; tune both against the PostgreSQL pool and host memory.
UPLINK_WORK_CONCURRENCY=16
UPLINK_WORK_CAPACITY=1024
# Total buffered payload bytes across running + queued uplinks (memory
# ceiling; must be >= UPLINK_MAX_PACKET_BYTES).
UPLINK_WORK_MAX_BYTES=33554432

# Plugin dispatcher and containerised Plugin Hosts.
# Plugin <-> dispatcher transport. oRPC v2 uses one bidirectional WebSocket;
# HTTP MessagePack remains available as a migration fallback.
PLUGIN_RPC_TRANSPORT=orpc-ws
# Comma-separated compile-time plugin-id=WebSocket endpoint mappings.
PLUGIN_HOST_ENDPOINTS=soulcloud.generic=ws://plugin-host-generic:8090/rpc/ws
# Legacy HTTP fallback (used only when PLUGIN_HOST_ENDPOINTS is empty).
PLUGIN_HOST_URLS=
# Shared bearer token for dispatcher <-> host containers (>=16 chars).
PLUGIN_HOST_AUTH_TOKEN=replace-with-a-long-random-token
# Synchronous action-encoding endpoint (API -> dispatcher -> host).
# Encoders are plugin code: they execute in the plugin host, never in the API.
PLUGIN_DISPATCHER_HTTP_PORT=8091
PLUGIN_DISPATCHER_HTTP_BIND=0.0.0.0
# Shared bearer token for API <-> dispatcher (>=16 chars). The API needs
# PLUGIN_DISPATCHER_URL pointing at this dispatcher endpoint.
PLUGIN_DISPATCHER_AUTH_TOKEN=replace-with-a-long-random-token
PLUGIN_ENCODE_TIMEOUT_MS=5000
# Event loop cadence and leasing
PLUGIN_EVENT_POLL_INTERVAL_MS=500
PLUGIN_EVENT_LEASE_SECONDS=60
# Per-event dispatcher deadline; a timeout drops the HTTP client. The
# container runtime owns host restart. Must stay below lease seconds.
PLUGIN_EVENT_TIMEOUT_MS=10000
# Retry policy: attempts, exponential backoff (with jitter) and its cap
PLUGIN_EVENT_MAX_ATTEMPTS=5
PLUGIN_EVENT_BACKOFF_BASE_MS=1000
PLUGIN_EVENT_BACKOFF_MAX_MS=300000
# Fairness: global in-flight events and the per-installation floor
PLUGIN_MAX_IN_FLIGHT=16
PLUGIN_PER_INSTALLATION_CONCURRENCY=4
# MessagePack-RPC request/response body ceiling shared by dispatcher and hosts
PLUGIN_HOST_MAX_FRAME_BYTES=1048576
PLUGIN_RPC_MAX_FRAME_BYTES=1048576
PLUGIN_HOST_WS_BACKPRESSURE_BYTES=4194304
PLUGIN_HOST_WS_IDLE_TIMEOUT_SECONDS=60
PLUGIN_HOST_MAX_WS_CONNECTIONS=16
PLUGIN_RPC_BACKPRESSURE_BYTES=4194304
PLUGIN_RPC_MAX_PENDING_REQUESTS=128
PLUGIN_RPC_HEARTBEAT_INTERVAL_MS=15000
PLUGIN_RPC_HEARTBEAT_TIMEOUT_MS=3000
PLUGIN_RPC_RECONNECT_BASE_MS=500
PLUGIN_RPC_RECONNECT_MAX_MS=30000
PLUGIN_RPC_MAX_OPERATIONS=64
PLUGIN_RPC_MAX_REVERSE_IN_FLIGHT=64
PLUGIN_RPC_PER_PLUGIN_REVERSE_IN_FLIGHT=16
PLUGIN_RPC_PER_INSTALLATION_REVERSE_IN_FLIGHT=8
PLUGIN_RPC_PER_OPERATION_REVERSE_IN_FLIGHT=4
PLUGIN_RPC_MAX_REVERSE_CALLS_PER_OPERATION=64
PLUGIN_RPC_MAX_STAGED_COMMANDS_PER_OPERATION=16
PLUGIN_RPC_MAX_BLOBS=16
PLUGIN_RPC_MAX_BLOB_BYTES=65536
PLUGIN_RPC_MAX_TOTAL_BLOB_BYTES=262144
PLUGIN_RPC_MAX_DEPTH=32
PLUGIN_RPC_MAX_NODES=4096
PLUGIN_RPC_MAX_ARRAY_ITEMS=4096
PLUGIN_RPC_MAX_STRING_BYTES=65536
# Plugin Host container resources. Keep the CPU/PID limits per plugin so a
# broken worker cannot consume the whole machine. The host filesystem is
# read-only and the container is attached only to its dispatcher network.
PLUGIN_HOST_MEMORY_LIMIT=512m
PLUGIN_HOST_CPU_LIMIT=1.0
PLUGIN_HOST_PID_LIMIT=128
# The container-local supervisor recovers a synchronous event-loop hang under
# plain Docker Compose. Kubernetes/another orchestrator should also configure
# a liveness probe for the host service.
PLUGIN_HOST_HEALTH_INTERVAL_SECONDS=5
PLUGIN_HOST_HEALTH_TIMEOUT_SECONDS=2
PLUGIN_HOST_HEALTH_FAILURES=3
PLUGIN_HOST_HEALTH_STARTUP_GRACE_SECONDS=15
PLUGIN_HOST_RESTART_DELAY_SECONDS=1
PLUGIN_HOST_MAX_RESTARTS=5
PLUGIN_HOST_RESTART_WINDOW_SECONDS=60
# Network names are explicit so the Traefik sidecar can join only the app
# network; plugin networks remain internal and per-host.
SOULCLOUD_APP_NETWORK=soulcloudjs_app
SOULCLOUD_PLUGIN_GENERIC_NETWORK=soulcloudjs_plugin_generic
# Rapid-failure circuit: after N host connection failures inside the window, the plugin is
# benched for the cooldown (its installations fail fast; others keep running)
PLUGIN_HOST_CRASH_THRESHOLD=5
PLUGIN_HOST_CRASH_WINDOW_MS=60000
PLUGIN_HOST_CRASH_COOLDOWN_MS=30000
# Lease recovery + installation version-drift sweep cadence
PLUGIN_SWEEP_INTERVAL_MS=15000
# Retention worker: terminal plugin events and entity history are deleted in
# bounded batches after these ages. Tune per deployment/data-retention policy.
PLUGIN_RETENTION_INTERVAL_MS=3600000
PLUGIN_EVENT_RETENTION_DAYS=30
PLUGIN_ENTITY_HISTORY_RETENTION_DAYS=365
PLUGIN_RETENTION_BATCH_SIZE=1000
