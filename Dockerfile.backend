# Shared base for the API and broker images: a Bun workspace with the
# generated Prisma client. Both processes share JWT_SECRET and DATABASE_URL.
FROM oven/bun:1.4.0-debian AS base

WORKDIR /app

# dependency layer: lockfile + all workspace manifests first
COPY package.json bun.lock ./
COPY packages/core/package.json packages/core/package.json
COPY packages/api/package.json packages/api/package.json
COPY packages/broker/package.json packages/broker/package.json
COPY packages/web/package.json packages/web/package.json
COPY packages/plugin-sdk/package.json packages/plugin-sdk/package.json
COPY packages/plugin-rpc-contract/package.json packages/plugin-rpc-contract/package.json
COPY packages/plugin-manager/package.json packages/plugin-manager/package.json
COPY packages/plugin-runtime/package.json packages/plugin-runtime/package.json
COPY packages/soulinjector-plugin/package.json packages/soulinjector-plugin/package.json
RUN bun install --frozen-lockfile

# source + generated client (root tsconfig is extended by packages)
COPY tsconfig.json ./
COPY packages/core packages/core
COPY packages/api packages/api
COPY packages/broker packages/broker
COPY packages/plugin-sdk packages/plugin-sdk
COPY packages/plugin-rpc-contract packages/plugin-rpc-contract
COPY packages/plugin-manager packages/plugin-manager
COPY packages/plugin-runtime packages/plugin-runtime
COPY packages/soulinjector-plugin packages/soulinjector-plugin
# prisma.config.ts needs a datasource url at generate time (no connection made)
ARG DATABASE_URL=postgres://soulcloud:soulcloud@postgres:5432/soulcloud
ENV DATABASE_URL=$DATABASE_URL
RUN bun run --cwd packages/core db:generate

# --- api ---------------------------------------------------------------------
FROM base AS api
ENV API_BIND_ADDRESS=0.0.0.0:8080
EXPOSE 8080
# apply migrations (idempotent) before serving — a fresh database must
# be migrated before the API can query it
CMD ["sh", "-c", "bun run db:deploy && bun run packages/api/src/index.ts"]

# --- broker -------------------------------------------------------------------
FROM base AS broker
ENV MQTT_BROKER_PORT=1883
EXPOSE 1883
CMD ["bun", "run", "packages/broker/src/index.ts"]

# --- plugin-manager ----------------------------------------------------------
FROM base AS plugin-manager
EXPOSE 8091
CMD ["bun", "run", "packages/plugin-manager/src/index.ts"]

# --- plugin ------------------------------------------------------------------
# The deployment supplies PLUGIN_ENTRYPOINT in a plugin-specific image. This
# image contains only the generic runtime; it never loads plugin code in the
# manager or API process.
FROM base AS plugin
ENV PLUGIN_BIND=0.0.0.0
ENV PLUGIN_PORT=8090
USER bun
EXPOSE 8090
CMD ["bun", "run", "packages/plugin-runtime/src/index.ts"]

# --- SoulInjector plugin ----------------------------------------------------
# The plugin has its own PostgreSQL connection and is never loaded into the
# API or Plugin Manager process. Docker Compose/systemd/Kubernetes owns this
# process lifecycle.
FROM base AS soulinjector-plugin
ENV PLUGIN_BIND=0.0.0.0
ENV PLUGIN_PORT=8090
USER bun
EXPOSE 8090
CMD ["bun", "run", "packages/soulinjector-plugin/src/runtime.ts"]
