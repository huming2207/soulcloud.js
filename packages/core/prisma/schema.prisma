// SoulcloudJS database schema.
//
// PostgreSQL CHECK constraints that Prisma cannot represent are documented
// beside each field and enforced via raw SQL in the initial migration.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String              @id @default(uuid()) @db.Uuid
  /// CHECK users_username_not_blank: btrim(username) <> ''
  username     String              @unique @db.VarChar(64)
  /// CHECK users_password_hash_not_blank: btrim(password_hash) <> ''
  passwordHash String              @map("password_hash") @db.Text
  /// CHECK users_email_not_blank: btrim(email) <> ''
  email        String              @unique @db.VarChar(254)
  memberships  OrganisationUser[]
  projects     UserProject[]
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Refresh tokens (server-side, revocable). Only the SHA-256 of the token
/// is stored; rotation chains are tracked for reuse detection.
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz()
  /// id of the token this one rotated from (reuse detection chain)
  rotatedFrom String?   @map("rotated_from") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  @@index([userId])
  @@map("refresh_tokens")
}

/// Direct user -> project membership (personal projects; organisations
/// remain a future multi-tenant layer).
model UserProject {
  userId    String  @map("user_id") @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId], map: "user_projects_pkey")
  @@index([projectId])
  @@map("user_projects")
}

model Organisation {
  id           String                @id @default(uuid()) @db.Uuid
  /// CHECK organisations_name_not_blank: btrim(name) <> ''
  name         String                @db.VarChar(255)
  /// CHECK organisations_website_url_not_blank: btrim(website_url) <> ''
  websiteUrl   String                @map("website_url") @db.Text
  userMembers  OrganisationUser[]
  projectLinks OrganisationProject[]

  @@map("organisations")
}

model Project {
  id           String                @id @default(uuid()) @db.Uuid
  /// CHECK projects_name_not_blank: btrim(name) <> ''
  name         String                @db.VarChar(255)
  orgLinks     OrganisationProject[]
  devices      Device[]
  artifacts    FirmwareArtifact[]
  releases     FirmwareRelease[]
  otaJobs      OtaJob[]
  rollouts     OtaRollout[]
  userLinks    UserProject[]
  installations PluginInstallation[]

  @@map("projects")
}

model Device {
  id               String           @id @default(uuid()) @db.Uuid
  /// Hardware-reported identifier; globally unique.
  /// CHECK devices_device_uid_not_blank: btrim(device_uid) <> ''
  deviceUid        String           @unique @map("device_uid") @db.VarChar(128)
  /// Human-assigned identifier; unique within one project.
  /// CHECK devices_assigned_id_not_blank: btrim(assigned_id) <> ''
  assignedId       String           @map("assigned_id") @db.VarChar(128)
  /// CHECK devices_password_hash_not_blank: btrim(password_hash) <> ''
  passwordHash     String           @map("password_hash") @db.Text
  /// Revoked credentials: new MQTT connections are refused until re-issued
  authRevoked      Boolean          @default(false) @map("auth_revoked")
  projectId        String           @map("project_id") @db.Uuid
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)

  // --- plugin / profile binding (see docs/zh/plugin-and-station-architecture.md §3) ---
  /// Installation this device is routed to. NULL = builtin soulcloud.generic
  /// profile (existing devices keep their current protocol behaviour).
  pluginInstallationId String?     @map("plugin_installation_id") @db.Uuid
  pluginInstallation   PluginInstallation? @relation(fields: [pluginInstallationId], references: [id], onDelete: SetNull)
  /// Builtin profile when NULL: ("soulcloud.generic", "generic", 1).
  /// CHECK devices_plugin_profile_consistent: the three profile columns are
  /// either all NULL or all set (enforced in the migration SQL).
  pluginId         String?          @map("plugin_id") @db.VarChar(255)
  profileId        String?          @map("profile_id") @db.VarChar(255)
  profileVersion   Int?             @map("profile_version")
  /// Per-device configuration validated against the profile's schema
  profileConfiguration Json?       @map("profile_configuration")
  /// CHECK devices_next_command_sequence_positive: next_command_sequence > 0
  nextCommandSeq   BigInt           @default(1) @map("next_command_sequence")
  commands         DeviceCommand[]
  firmwareState    DeviceFirmwareState?
  logEvents        RawLogEvent[]
  otaTargets       OtaTarget[]
  rolloutPool      OtaRolloutPool[]
  pluginEvents     PluginEvent[]
  entityRegistrations EntityRegistry[]

  @@unique([projectId, assignedId], map: "devices_project_assigned_id_unique")
  @@map("devices")
}

model OrganisationUser {
  organisationId String       @map("organisation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organisationId, userId], map: "organisation_users_pkey")
  @@index([userId], map: "organisation_users_user_id_idx")
  @@map("organisation_users")
}

model OrganisationProject {
  organisationId String       @map("organisation_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([organisationId, projectId], map: "organisation_projects_pkey")
  @@index([projectId], map: "organisation_projects_project_id_idx")
  @@map("organisation_projects")
}

model CommandBatch {
  id          String           @id @db.Uuid
  /// CHECK command_batches_device_count_positive: device_count > 0
  deviceCount Int              @map("device_count")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  commands    DeviceCommand[]

  @@map("command_batches")
}

model DeviceCommand {
  id                String       @id @db.Uuid
  batchId           String       @map("batch_id") @db.Uuid
  batch             CommandBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  deviceId          String       @map("device_id") @db.Uuid
  device            Device       @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  /// CHECK device_commands_sequence_positive: sequence > 0
  sequence          BigInt
  /// MessagePack-encoded DeviceCommandExecution
  payload           Bytes
  /// State: queued | leased | broker_accepted | device_completed | delivery_failed
  state             String       @default("queued") @db.VarChar(32)
  /// Absolute deadline for delivery; NULL = never expires (the command is
  /// retried until the device completes it). Past deadline -> delivery_failed.
  deliveryExpiresAt DateTime?    @map("delivery_expires_at") @db.Timestamptz()
  /// CHECK device_commands_attempt_count_nonnegative: attempt_count >= 0
  attemptCount      Int          @default(0) @map("attempt_count")
  availableAt       DateTime     @default(now()) @map("available_at") @db.Timestamptz()
  leaseExpiresAt    DateTime?    @map("lease_expires_at") @db.Timestamptz()
  brokerAcceptedAt  DateTime?    @map("broker_accepted_at") @db.Timestamptz()
  resultCode        Int?         @map("result_code")
  /// MessagePack-encoded DeviceCommandResult
  resultPacket      Bytes?       @map("result_packet")
  deviceCompletedAt DateTime?    @map("device_completed_at") @db.Timestamptz()
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([batchId, deviceId], map: "device_commands_batch_device_unique")
  @@unique([deviceId, sequence], map: "device_commands_device_sequence_unique")
  @@map("device_commands")
}

// --- on9log ingestion (see llm-docs/soulcloudjs/15-log-ingestion-proposal.md) ---

/// Firmware build artifact (ELF uploaded once per build).
model FirmwareArtifact {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// ELF SHA-256 (exact build identity, unique per project)
  buildId     String   @db.VarChar(64)
  /// Human-readable version label (reference only, never identity)
  version     String?  @db.VarChar(255)
  /// ELF binary (DB storage for the initial stage)
  elfBytes    Bytes    @map("elf_bytes")
  elfSize     Int      @map("elf_size")
  /// pending | imported | failed
  importState String   @default("pending") @map("import_state") @db.VarChar(32)
  /// Failure reason (internal; not exposed to clients)
  importError String?  @map("import_error") @db.Text
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz()
  logStrings  FirmwareLogString[]
  logEvents   RawLogEvent[]
  releases    FirmwareRelease[]

  @@unique([projectId, buildId], map: "firmware_artifacts_project_build_unique")
  @@index([projectId, uploadedAt])
  @@map("firmware_artifacts")
}

// --- OTA firmware releases (see llm-docs/soulcloudjs/16-ota-firmware-releases-proposal.md) ---

/// OTA release: a distributable firmware image (bin), optionally tied to an
/// ELF artifact for build identity / on9log decoding.
model FirmwareRelease {
  id         String            @id @default(uuid()) @db.Uuid
  projectId  String            @map("project_id") @db.Uuid
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// Optional link to the ELF artifact (build identity = ELF hash)
  artifactId String?           @map("artifact_id") @db.Uuid
  artifact   FirmwareArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  /// SHA-256 of the bin image (unique per project, idempotent re-upload)
  binHash    String            @map("bin_hash") @db.VarChar(64)
  /// bin image bytes (DB storage for the initial stage)
  binBytes   Bytes             @map("bin_bytes")
  binSize    Int               @map("bin_size")
  /// Human-readable version label (reference only, never identity)
  version    String?           @db.VarChar(255)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  otaJobs    OtaJob[]
  rollouts   OtaRollout[]
  rollbackFor OtaRollout[]     @relation("rollout_from")

  @@unique([projectId, binHash], map: "firmware_releases_project_bin_unique")
  @@index([projectId, createdAt])
  @@map("firmware_releases")
}

// --- OTA deployment (see llm-docs/soulcloudjs/17-ota-mqtt-deploy-proposal.md) ---

/// One OTA deployment job (user-initiated batch).
model OtaJob {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  releaseId String      @map("release_id") @db.Uuid
  release   FirmwareRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  /// users.id of the deploying human
  createdBy String      @map("created_by") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  targets   OtaTarget[]
  rollbackFor OtaRollout? @relation("rollout_rollback")
  rolloutPhase OtaRolloutPhase?

  @@index([projectId, createdAt])
  @@map("ota_jobs")
}

/// Per-device OTA delivery target (the broker's durable outbox).
model OtaTarget {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  job       OtaJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  deviceId  String   @map("device_id") @db.Uuid
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  /// pending | leased | delivered | delivering | downloaded | installed |
  /// expired | completed | failed
  state     String   @default("pending") @db.VarChar(32)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz()
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz()
  /// Device acknowledgement time (completed/failed terminal states)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz()
  /// When the device reported `installed` (stall-judgement basis)
  installedAt DateTime? @map("installed_at") @db.Timestamptz()
  /// 0 = success (completed); negative = failure code (failed)
  resultCode Int? @map("result_code")
  resultMessage String? @map("result_message") @db.VarChar(512)
  /// Earliest time the target may be claimed again (offline backoff)
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz()
  /// Delivery window deadline: a pending target is expired after this
  /// (the download JWT is minted at publish time and outlives it by design)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz()
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([state, expiresAt])
  @@index([jobId])
  @@map("ota_targets")
}

// --- OTA rollout (see llm-docs/soulcloudjs/19-ota-rollout-proposal.md) ---

/// One OTA rollout: a phased firmware deployment over a device pool.
model OtaRollout {
  id             String            @id @default(uuid()) @db.Uuid
  projectId      String            @map("project_id") @db.Uuid
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  releaseId      String            @map("release_id") @db.Uuid
  release        FirmwareRelease   @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  /// Baseline firmware for rollback (must be an existing release)
  fromReleaseId  String?           @map("from_release_id") @db.Uuid
  fromRelease    FirmwareRelease?  @relation("rollout_from", fields: [fromReleaseId], references: [id], onDelete: SetNull)
  /// running | paused | aborted | completed
  state          String            @default("running") @db.VarChar(32)
  /// auto (server-randomized ratios) | grouped (client-chosen groups)
  strategy       String            @db.VarChar(32)
  /// Gating settings (per-rollout, user-tunable at creation)
  successRatio   Float             @default(0.9) @map("success_ratio")
  minSample      Int               @default(10) @map("min_sample")
  phaseTimeoutHours Int            @default(24) @map("phase_timeout_hours")
  stuckHours     Int               @default(6) @map("stuck_hours")
  manualApproval Boolean           @default(false) @map("manual_approval")
  /// rollback job created by POST /rollouts/:id/rollback
  rollbackJobId  String?           @unique @map("rollback_job_id") @db.Uuid
  rollbackJob    OtaJob?           @relation("rollout_rollback", fields: [rollbackJobId], references: [id], onDelete: SetNull)
  createdBy      String            @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  phases         OtaRolloutPhase[]
  pool           OtaRolloutPool[]

  @@index([projectId, createdAt])
  @@map("ota_rollouts")
}

/// Device pool snapshot (auto: random sort_idx; grouped: client order).
model OtaRolloutPool {
  id        String     @id @default(uuid()) @db.Uuid
  rolloutId String     @map("rollout_id") @db.Uuid
  rollout   OtaRollout @relation(fields: [rolloutId], references: [id], onDelete: Cascade)
  deviceId  String     @map("device_id") @db.Uuid
  device    Device     @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  sortIdx   Int        @map("sort_idx")

  @@unique([rolloutId, deviceId], map: "ota_rollout_pool_rollout_device_unique")
  @@unique([rolloutId, sortIdx], map: "ota_rollout_pool_rollout_sort_unique")
  @@map("ota_rollout_pool")
}

/// One phase of a rollout. Activation creates the phase's ota_job.
model OtaRolloutPhase {
  id          String      @id @default(uuid()) @db.Uuid
  rolloutId   String      @map("rollout_id") @db.Uuid
  rollout     OtaRollout  @relation(fields: [rolloutId], references: [id], onDelete: Cascade)
  /// 1-based
  index       Int
  /// auto strategy only: cumulative coverage (last = 1.0)
  ratio       Float?
  /// grouped strategy only: the client-provided group number
  groupId     Int?        @map("group_id")
  /// pending | active | completed | paused
  state       String      @default("pending") @db.VarChar(32)
  /// Number of devices this phase covers (auto: ceil(ratio*pool);
  /// grouped: the group size) — the phase's job is sliced by cumulative
  /// sort_idx ranges over the pool
  targetCount Int         @map("target_count")
  jobId       String?     @unique @map("job_id") @db.Uuid
  job         OtaJob?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  activatedAt DateTime?   @map("activated_at") @db.Timestamptz()
  completedAt DateTime?   @map("completed_at") @db.Timestamptz()

  @@unique([rolloutId, index])
  @@map("ota_rollout_phases")
}

/// ELF address -> string dictionary for one artifact (tag/format resolution).
model FirmwareLogString {
  id         String           @id @default(uuid()) @db.Uuid
  artifactId String           @map("artifact_id") @db.Uuid
  artifact   FirmwareArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  /// 32-bit ELF virtual address (tag_id / fmt_id); BigInt because ELF
  /// addresses are unsigned 32-bit and can exceed int4 (2^31-1)
  address    BigInt
  /// tag | format
  kind       String           @db.VarChar(16)
  value      String           @db.Text

  @@unique([artifactId, address, kind], map: "firmware_log_strings_unique")
  @@index([artifactId, kind])
  @@map("firmware_log_strings")
}

/// Immutable raw log events (source of truth; one row per packet).
model RawLogEvent {
  id           BigInt            @id @default(autoincrement())
  deviceId     String            @map("device_id") @db.Uuid
  device       Device            @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  /// Decoding firmware; null when unknown (raw is kept and can be backfilled)
  artifactId   String?           @map("artifact_id") @db.Uuid
  artifact     FirmwareArtifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)
  /// Server UTC receive time (cross-device query baseline)
  receivedAt   DateTime          @default(now()) @map("received_at") @db.Timestamptz()
  /// Boot-relative milliseconds from the packet (in-session ordering);
  /// unsigned 32-bit on the wire, exceeds int4 after ~24.8 days uptime
  deviceTimeMs BigInt            @map("device_time_ms")
  /// 16-bit sequence (wrap detection)
  sequence     Int
  packetType   Int               @map("packet_type")
  /// 0..5 for LOG packets, null otherwise
  level        Int?
  tagId        BigInt?           @map("tag_id")
  fmtId        BigInt?           @map("fmt_id")
  /// Complete raw packet (header + payload)
  rawPacket    Bytes             @map("raw_packet")
  /// unknown_fw | decodable
  decodeState  String            @default("unknown_fw") @map("decode_state") @db.VarChar(32)

  @@index([deviceId, id], map: "raw_log_events_device_idx")
  /// Keyset index for the time-ranged log export (perf audit; created by
  /// migration 20260813020000 but previously missing here — schema drift
  /// that made later `migrate dev` want to drop it)
  @@index([deviceId, receivedAt, id], map: "raw_log_events_device_time_id_idx")
  @@index([artifactId, tagId, id], map: "raw_log_events_artifact_idx")
  @@index([receivedAt], map: "raw_log_events_time_idx")
  @@map("raw_log_events")
}

/// Latest reported firmware per device (from stat.fw).
model DeviceFirmwareState {
  deviceId   String   @id @map("device_id") @db.Uuid
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// stat.fw as hex
  fwHash     String   @map("fw_hash") @db.VarChar(64)
  reportedAt DateTime @default(now()) @map("reported_at") @db.Timestamptz()
  @@map("device_firmware_state")
}

// --- plugin system (see docs/zh/plugin-and-station-architecture.md) ---------
// Implemented for stage 1 (SDK skeleton + entity model) and stage 2
// (dispatcher / plugin host process isolation).

/// One plugin enabled for one project (§3). `configured_plugin_version`
/// must exactly match the version deployed in the registry; a mismatch
/// moves the installation to `error` (never auto-upgrade/downgrade).
model PluginInstallation {
  id                      String    @id @default(uuid()) @db.Uuid
  projectId               String    @map("project_id") @db.Uuid
  project                 Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// CHECK plugin_installations_plugin_id_not_blank
  pluginId                String    @map("plugin_id") @db.VarChar(255)
  /// CHECK plugin_installations_version_not_blank
  configuredPluginVersion String    @map("configured_plugin_version") @db.VarChar(64)
  /// enabled | draining | disabled | error (CHECK in migration SQL)
  state                   String    @default("enabled") @db.VarChar(32)
  /// Why the installation is in `error` (version drift, bad config, ...)
  errorDetail             String?   @map("error_detail") @db.Text
  configJson              Json?     @map("config_json")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  devices                 Device[]
  events                  PluginEvent[]

  @@index([pluginId])
  @@map("plugin_installations")
}

/// Immutable descriptor snapshot per entity (§4.1). Entity semantics are
/// interpreted with the revision that was current when the sample was
/// taken; renames create new entity keys and deprecate the old row.
model EntityDescriptorRevision {
  id          String   @id @default(uuid()) @db.Uuid
  pluginId    String   @map("plugin_id") @db.VarChar(255)
  profileId   String   @map("profile_id") @db.VarChar(255)
  profileVersion Int    @map("profile_version")
  entityKey   String   @map("entity_key") @db.VarChar(255)
  /// 1-based, monotonic per (plugin_id, profile_id, profile_version, entity_key)
  revision    Int
  /// Full EntityDescriptor JSON snapshot
  descriptor  Json
  deprecated  Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  entities    EntityRegistry[]
  history     EntityHistory[]

  @@unique([pluginId, profileId, profileVersion, entityKey, revision], map: "entity_descriptor_revisions_identity_unique")
  @@index([pluginId, profileId, profileVersion, entityKey])
  @@map("entity_descriptor_revisions")
}

/// One registered entity per (device, plugin, entity_key) (§4).
model EntityRegistry {
  id                  String   @id @default(uuid()) @db.Uuid
  deviceId            String   @map("device_id") @db.Uuid
  device              Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  pluginId            String   @map("plugin_id") @db.VarChar(255)
  entityKey           String   @map("entity_key") @db.VarChar(255)
  descriptorRevisionId String  @map("descriptor_revision_id") @db.Uuid
  descriptorRevision  EntityDescriptorRevision @relation(fields: [descriptorRevisionId], references: [id], onDelete: Restrict)
  deprecated          Boolean  @default(false)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  currentState        EntityCurrentState?
  history             EntityHistory[]

  @@unique([deviceId, pluginId, entityKey], map: "entity_registry_identity_unique")
  @@index([deviceId])
  @@map("entity_registry")
}

/// Latest state per registered entity (§4). Kept separate from history:
/// hot reads never scan history rows.
model EntityCurrentState {
  entityRegistryId String   @id @map("entity_registry_id") @db.Uuid
  entity           EntityRegistry @relation(fields: [entityRegistryId], references: [id], onDelete: Cascade)
  value            Json?
  /// good | bad | uncertain | stale | unknown (CHECK in migration SQL)
  quality          String   @default("unknown") @db.VarChar(16)
  sourceTimestamp  DateTime? @map("source_timestamp") @db.Timestamptz()
  ingestedAt       DateTime @default(now()) @map("ingested_at") @db.Timestamptz()
  /// Optional producer-side ordering token
  sequence         BigInt?
  /// info | warning | critical (CHECK in migration SQL)
  alarmLevel       String?  @map("alarm_level") @db.VarChar(16)
  alarmCode        String? @map("alarm_code") @db.VarChar(64)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("entity_current_state")
}

/// Append-only entity samples (§4). History policy comes from the
/// descriptor revision that was current when the update was applied.
model EntityHistory {
  id                 BigInt   @id @default(autoincrement())
  entityRegistryId   String   @map("entity_registry_id") @db.Uuid
  entity             EntityRegistry @relation(fields: [entityRegistryId], references: [id], onDelete: Cascade)
  descriptorRevisionId String @map("descriptor_revision_id") @db.Uuid
  descriptorRevision EntityDescriptorRevision @relation(fields: [descriptorRevisionId], references: [id], onDelete: Restrict)
  /// Denormalised for the "all entities of one device over time" query
  deviceId           String   @map("device_id") @db.Uuid
  value              Json?
  quality            String   @db.VarChar(16)
  sourceTimestamp    DateTime? @map("source_timestamp") @db.Timestamptz()
  ingestedAt         DateTime @default(now()) @map("ingested_at") @db.Timestamptz()
  sequence           BigInt?
  alarmLevel         String?  @map("alarm_level") @db.VarChar(16)
  alarmCode          String? @map("alarm_code") @db.VarChar(64)

  @@index([entityRegistryId, id], map: "entity_history_entity_idx")
  @@index([deviceId, id], map: "entity_history_device_idx")
  @@map("entity_history")
}

/// Durable plugin event inbox (§6.3). Routing is derived from the device's
/// installation binding at enqueue time; devices never choose the plugin.
/// States: pending | leased | failed | completed | dead. `failed` means
/// "attempt failed, retry scheduled via available_at"; `dead` is terminal.
model PluginEvent {
  id                   String    @id @default(uuid()) @db.Uuid
  pluginInstallationId String    @map("plugin_installation_id") @db.Uuid
  installation         PluginInstallation @relation(fields: [pluginInstallationId], references: [id], onDelete: Cascade)
  deviceId             String    @map("device_id") @db.Uuid
  device               Device    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  /// Routing identity is snapshotted at enqueue time; the current device
  /// binding may change while this event is waiting or retrying.
  projectId            String    @map("project_id") @db.Uuid
  deviceUid            String    @map("device_uid") @db.VarChar(255)
  pluginId             String    @map("plugin_id") @db.VarChar(255)
  pluginVersion        String    @map("plugin_version") @db.VarChar(64)
  profileId            String    @map("profile_id") @db.VarChar(255)
  profileVersion       Int       @map("profile_version")
  installationConfig   Json?     @map("installation_config")
  /// CHECK plugin_events_event_kind_not_blank
  eventKind            String    @map("event_kind") @db.VarChar(255)
  /// CHECK plugin_events_schema_version_positive
  schemaVersion        Int       @map("schema_version")
  payload              Json
  /// pending | leased | failed | completed | dead (CHECK in migration SQL)
  state                String    @default("pending") @db.VarChar(16)
  /// CHECK plugin_events_attempt_count_nonnegative
  attemptCount         Int       @default(0) @map("attempt_count")
  availableAt          DateTime  @default(now()) @map("available_at") @db.Timestamptz()
  leaseExpiresAt       DateTime? @map("lease_expires_at") @db.Timestamptz()
  /// Repeated uploads with the same key are idempotent within one device.
  idempotencyKey       String?   @map("idempotency_key") @db.VarChar(255)
  lastError            String?   @map("last_error") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  /// Set on terminal states (completed and dead)
  finishedAt           DateTime? @map("finished_at") @db.Timestamptz()

  @@index([deviceId, idempotencyKey], map: "plugin_events_device_idempotency_idx")
  @@index([state, availableAt], map: "plugin_events_state_available_idx")
  @@index([pluginInstallationId, state, availableAt], map: "plugin_events_installation_state_idx")
  @@map("plugin_events")
}
