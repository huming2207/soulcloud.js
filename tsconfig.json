{
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "types": [
      "bun-types"
    ],
    "paths": {
      "@soulcloud/core": [
        "./packages/core/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/core",
    "packages/api",
    "packages/broker",
    "scripts",
    "tests"
  ]
}